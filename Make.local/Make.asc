# Phlegethon Build Configuration - ASC MUSICA Cluster
# =====================================================

FC = mpifort

HDF5_DIR = /cvmfs/software.eessi.io/versions/2025.06/software/linux/x86_64/amd/zen4/software/HDF5/1.14.5-gompi-2024a

FFLAGS = -O3 -mtune=native -march=native -ftree-vectorize \
         -ftree-vectorizer-verbose=0 -funroll-loops -fforce-addr \
         -Wall -Wextra

INCLUDE = -I$(HDF5_DIR)/include

LIBS = -L$(HDF5_DIR)/lib

HDF5_LIB = -lhdf5 -lhdf5_fortran -lz

RPATH = -Wl,-rpath,$(HDF5_DIR)/lib


# Common settings
BUILD_DIR ?= obj
FC_ADD_DEF ?= -D

# Construct FC_OPTS from OPTS and define EXE
FC_OPTS += $(foreach opt,$(OPTS),$(FC_ADD_DEF) $(opt))
EXE = run.$(APPNAME)

# Display configuration being used
$(info ----------------------------------------)
$(info Phlegethon Build Configuration)
$(info Configuration: HITS genoa)
$(info FC: $(FC))
$(info FFLAGS: $(FFLAGS))
$(info INCLUDE: $(INCLUDE))
$(info LIBS: $(LIBS))
$(info HDF5_LIB: $(HDF5_LIB))
$(info ----------------------------------------)
